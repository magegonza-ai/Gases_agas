{
  "name": "prominer-frontend",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "description": "PROMINER - Control de Envases y Llenado de Gases Industriales",
  "author": "PROMINER",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:dir": "npm run build && electron-builder --win --x64 --dir"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.prominer.app",
    "productName": "PROMINER",
    "copyright": "Copyright © 2026 PROMINER",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/node_modules/**",
          "!**/.git/**",
          "!**/tests/**",
          "!**/*.test.js",
          "!**/*.log",
          "!**/*.db*",
          "!**/.env*"
        ]
      },
      {
        "from": "..",
        "to": "",
        "filter": [
          "schema_sqlite.sql"
        ]
      }
    ],
    "win": {
      "target": "portable",
      "icon": "public/prominer-logo.png"
    },
    "portable": {
      "artifactName": "PROMINER-${version}-portable.exe"
    },
    "mac": {
      "target": []
    },
    "linux": {
      "target": []
    },
    "asar": true,
    "asarUnpack": [
      "backend/**/*"
    ],
    "npmRebuild": true,
    "forceCodeSigning": false,
    "generateUpdatesFilesForAllChannels": false,
    "publish": null,
    "cscLink": null,
    "cscKeyPassword": null
  },
  "dependencies": {
    "axios": "^1.19.0",
    "bootstrap": "^5.3.8",
    "pdfmake": "^0.3.11",
    "react": "^19.2.8",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.0.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0",
    "vitest": "^5.0.3",
    "wait-on": "^8.0.1"
  }
}
